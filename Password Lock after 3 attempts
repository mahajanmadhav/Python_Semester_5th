'''
1. Write a python program that asks the user to enter a username and password. the user should get only 3 attempts. if the correct credentials
are entered, display "login successful" and stop the loop. If all attempts are used, display "Account Locked" '''
correct_username = "admin"
correct_pw = "python127"
attempts = 3
while attempts>0:
    username = input("Enter Username:")
    pw = input("Enter Password:")
    if username == correct_username and pw == correct_pw:
        print("Login Successfully!!!")
        break
    else:
        attempts = attempts-1
        print("Wrong Details. Attempts left:",attempts)
if attempts == 0:
    print("Account Locked")
